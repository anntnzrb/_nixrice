{
    "assistant": {
        "button": false,
        "default_model": {
            "model": "claude-3-5-sonnet-latest",
            "provider": "zed.dev"
        },
        "default_width": 540,
        "dock": "right",
        "enabled": true,
        "version": "2"
    },
    "auto_install_extensions": {
        "just": true,
        "nix": true,
        "toml": true
    },
    "auto_update": false,
    "base_keymap": "VSCode",
    "buffer_font_family": "FantasqueSansM Nerd Font Mono",
    "buffer_font_size": 16,
    "cursor_blink": false,
    "features": {
        "inline_completion_provider": "supermaven"
    },
    "file_finder": {
        "file_icons": true
    },
    "format_on_save": "off",
    "indent_guides": {
        "active_line_width": 2,
        "background_coloring": "disabled",
        "coloring": "indent_aware",
        "enabled": true,
        "line_width": 6
    },
    "languages": {
        "Haskell": {
            "formatter": {
                "external": {
                    "arguments": ["--stdin-input-file", "{buffer_path}", "-"],
                    "command": "fourmolu"
                }
            }
        },
        "Nix": {
            "formatter": {
                "external": {
                    "command": "nixfmt"
                }
            },
            "language_servers": ["nixd", "!nil"]
        },
        "Python": {
            "formatter": {
                "external": {
                    "arguments": ["format", "--stdin-filename", "{buffer_path}"],
                    "command": "ruff"
                }
            },
            "language_servers": ["pyright", "ruff"]
        }
    },
    "load_direnv": "shell_hook",
    "lsp": {
        "haskell-language-server": {
            "binary": {
                "path_lookup": true
            }
        },
        "nixd": {
            "binary": {
                "path_lookup": true
            }
        },
        "ruff": {
            "binary": {
                "path_lookup": true
            }
        },
        "rust-analyzer": {
            "binary": {
                "path_lookup": true
            }
        }
    },
    "outline_panel": {
        "auto_fold_dirs": true,
        "auto_reveal_entries": true,
        "button": true,
        "default_width": 240,
        "dock": "right",
        "file_icons": true,
        "folder_icons": true,
        "git_status": true,
        "indent_guides": {
            "show": "always"
        },
        "indent_size": 20
    },
    "project_panel": {
        "button": false,
        "dock": "right",
        "git_status": true,
        "indent_guides": {
            "show": "always"
        },
        "indent_size": 14
    },
    "relative_line_numbers": true,
    "restore_on_startup": "none",
    "scrollbar": {
        "show": "never"
    },
    "search": {
        "case_sensitive": false,
        "regex": true
    },
    "show_completions_on_input": false,
    "show_inline_completions": false,
    "show_whitespaces": "boundary",
    "show_wrap_guides": true,
    "soft_wrap": "editor_width",
    "tab_bar": {
        "show": true,
        "show_nav_history_buttons": false
    },
    "tab_size": 4,
    "tabs": {
        "file_icons": true,
        "git_status": true
    },
    "terminal": {
        "blinking": "off",
        "button": false,
        "copy_on_select": false,
        "detect_venv": "off",
        "dock": "bottom",
        "font_size": 12,
        "line_height": "comfortable"
    },
    "ui_font_family": "Inconsolata Nerd Font Mono",
    "ui_font_size": 16,
    "vim_mode": true,
    "wrap_guides": [80]
}
