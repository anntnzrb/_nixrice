+func TestQuotaFetchRejectsInvalidOrMissingUsageWindows(t *testing.T) {
+	const secret = "go-key-invalid-window-secret"
+	validWeekly := `"weekly":{"status":"ok","percent":29,"resetsAt":"2026-08-17T00:00:00Z"}`
+	validMonthly := `"monthly":{"status":"ok","percent":14,"resetsAt":"2026-09-13T21:51:50Z"}`
+	cases := []struct {
+		name string
+		body string
+	}{
+		{
+			name: "missing-window",
+			body: `{"usage":{"rolling":{"status":"ok","percent":8,"resetsAt":"2026-08-16T19:50:55Z"},"weekly":{"status":"ok","percent":29,"resetsAt":"2026-08-17T00:00:00Z"}}}`,
+		},
+		{
+			name: "missing-status",
+			body: `{"usage":{"rolling":{"percent":8,"resetsAt":"2026-08-16T19:50:55Z"},` + validWeekly + `,` + validMonthly + `}}`,
+		},
+		{
+			name: "missing-percent",
+			body: `{"usage":{"rolling":{"status":"ok","resetsAt":"2026-08-16T19:50:55Z"},` + validWeekly + `,` + validMonthly + `}}`,
+		},
+		{
+			name: "negative-percent",
+			body: `{"usage":{"rolling":{"status":"ok","percent":-1,"resetsAt":"2026-08-16T19:50:55Z"},` + validWeekly + `,` + validMonthly + `}}`,
+		},
+		{
+			name: "overfull-percent",
+			body: `{"usage":{"rolling":{"status":"ok","percent":101,"resetsAt":"2026-08-16T19:50:55Z"},` + validWeekly + `,` + validMonthly + `}}`,
+		},
+		{
+			name: "missing-reset",
+			body: `{"usage":{"rolling":{"status":"ok","percent":8},` + validWeekly + `,` + validMonthly + `}}`,
+		},
+		{
+			name: "invalid-reset",
+			body: `{"usage":{"rolling":{"status":"ok","percent":8,"resetsAt":"tomorrow"},` + validWeekly + `,` + validMonthly + `}}`,
+		},
+	}
+
+	for _, testCase := range cases {
+		t.Run(testCase.name, func(t *testing.T) {
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+				w.Header().Set("Content-Type", "application/json")
+				_, _ = w.Write([]byte(testCase.body))
+			}))
+			defer server.Close()
+
+			configPath := filepath.Join(t.TempDir(), "config.yaml")
+			setQuotaProviderConfig(t, configPath)
+			writeQuotaConfig(t, configPath, server.URL, secret)
+
+			raw, err := callQuotaFetch(t, quotaProviderID)
+			if err == nil {
+				t.Fatalf("quota.fetch result = %s, want invalid usage error", raw)
+			}
+			if strings.Contains(err.Error(), secret) || bytes.Contains(raw, []byte(secret)) {
+				t.Fatalf("quota.fetch failure leaks API key: error=%v result=%s", err, raw)
+			}
+		})
+	}
+}
+
+func callQuotaFetch(t *testing.T, provider string) ([]byte, error) {
+	t.Helper()
+	request, err := json.Marshal(quotaFetchRequest{
+		Provider: provider,
+	})
+	if err != nil {
+		t.Fatalf("encode quota.fetch request: %v", err)
+	}
+	return handleMethod("quota.fetch", request)
+}
+
+func decodeQuotaFetchResponse(t *testing.T, raw []byte) quotaFetchResponse {
+	t.Helper()
+	var envelope testEnvelope
+	if err := json.Unmarshal(raw, &envelope); err != nil {
+		t.Fatalf("decode quota.fetch envelope: %v", err)
+	}
+	if !envelope.OK {
+		t.Fatalf("quota.fetch envelope is not ok: %s", raw)
+	}
+	var response quotaFetchResponse
+	if err := json.Unmarshal(envelope.Result, &response); err != nil {
+		t.Fatalf("decode quota.fetch result: %v", err)
+	}
+	return response
+}
+
+func setQuotaProviderConfig(t *testing.T, configPath string) {
+	t.Helper()
+	previous := currentPluginConfig()
+	setPluginConfig(pluginConfig{
+		ConfigPath:     configPath,
+		ProviderNames:  []string{"quota-test"},
+		MaxConcurrency: 2,
+		TimeoutSeconds: 5,
+	})
+	t.Cleanup(func() { setPluginConfig(previous) })
+}
+
+func writeQuotaConfig(t *testing.T, path, baseURL string, keys ...string) {
+	t.Helper()
+	lines := []string{
+		"openai-compatibility:",
+		"  - name: quota-test",
+		"    base-url: " + baseURL,
+		"    api-key-entries:",
+	}
+	for _, key := range keys {
+		lines = append(lines, fmt.Sprintf("      - api-key: %q", key))
+	}
+	if err := os.WriteFile(path, []byte(strings.Join(lines, "\n")+"\n"), 0o600); err != nil {
+		t.Fatalf("write CLIProxy config: %v", err)
+	}
+}
+
+func assertQuotaGroup(t *testing.T, group quotaGroup, displayName string) {
+	t.Helper()
+	if group.DisplayName != displayName || len(group.Buckets) != 3 {
+		t.Fatalf("unexpected quota group: %#v", group)
+	}
+	windows := []string{"5h", "weekly", "monthly"}
+	descriptions := []string{"5-hour", "Weekly", "Monthly"}
+	remaining := []float64{0.92, 0.71, 0.86}
+	resets := []string{"2026-08-16T19:50:55Z", "2026-08-17T00:00:00Z", "2026-09-13T21:51:50.7Z"}
+	for index, bucket := range group.Buckets {
+		if bucket.Window != windows[index] || bucket.Description != descriptions[index] ||
+			math.Abs(bucket.RemainingFraction-remaining[index]) > 1e-9 || bucket.ResetTime != resets[index] {
+			t.Fatalf("unexpected %s quota bucket: %#v", windows[index], bucket)
+		}
+	}
+}
+
+func assertNoConfiguredKeys(t *testing.T, raw []byte, keys ...string) {
+	t.Helper()
+	for _, key := range keys {
+		if bytes.Contains(raw, []byte(key)) {
+			t.Fatalf("quota response leaks API key %q: %s", key, raw)
+		}
+	}
+}
