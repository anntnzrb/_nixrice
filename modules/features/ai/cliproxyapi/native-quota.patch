+package main
+
+import (
+	"context"
+	"encoding/json"
+	"errors"
+	"fmt"
+	"net/http"
+	"strings"
+	"time"
+
+	"github.com/duu261/opencode-go-pool/internal/cliproxyconfig"
+	"github.com/duu261/opencode-go-pool/internal/opencode"
+	"github.com/duu261/opencode-go-pool/internal/pool"
+)
+
+const quotaProviderID = "opencode-go"
+
+type quotaIdentifierResponse struct {
+	Identifier string `json:"identifier"`
+}
+
+type quotaDescribeResponse struct {
+	SupportedProviders []string `json:"supported_providers"`
+	DisplayName        string   `json:"display_name"`
+	SupportsReset      bool     `json:"supports_reset,omitempty"`
+}
+
+type quotaFetchRequest struct {
+	Provider string `json:"provider"`
+}
+
+type quotaFetchResponse struct {
+	Subscription quotaSubscription `json:"subscription"`
+	Summary      []quotaMetric     `json:"summary,omitempty"`
+	Groups       []quotaGroup      `json:"groups"`
+}
+
+type quotaMetric struct {
+	Key    string `json:"key"`
+	Label  string `json:"label"`
+	Value  int    `json:"value"`
+	Format string `json:"format"`
+}
+
+type quotaSubscription struct {
+	Plan string `json:"plan"`
+}
+
+type quotaGroup struct {
+	DisplayName string        `json:"displayName"`
+	Buckets     []quotaBucket `json:"buckets"`
+}
+
+type quotaBucket struct {
+	Window            string  `json:"window"`
+	RemainingFraction float64 `json:"remainingFraction"`
+	ResetTime         string  `json:"resetTime"`
+	Description       string  `json:"description"`
+}
+
+func handleQuotaFetch(raw []byte) ([]byte, error) {
+	var request quotaFetchRequest
+	if err := json.Unmarshal(raw, &request); err != nil {
+		return nil, fmt.Errorf("decode quota fetch request: %w", err)
+	}
+	if request.Provider != quotaProviderID {
+		return nil, fmt.Errorf("unsupported quota provider %q", request.Provider)
+	}
+
+	config := currentPluginConfig()
+	credentials, err := cliproxyconfig.Discover(config.ConfigPath, config.ProviderNames)
+	if err != nil {
+		return nil, fmt.Errorf("discover OpenCode Go credentials: %w", err)
+	}
+	if len(credentials) == 0 {
+		return nil, errors.New("no OpenCode Go credentials configured")
+	}
+
+	timeout := time.Duration(config.TimeoutSeconds) * time.Second
+	ctx, cancel := context.WithTimeout(context.Background(), timeout)
+	defer cancel()
+	results := pool.Collect(ctx, credentials, &http.Client{Timeout: timeout}, config.MaxConcurrency)
+	groups := make([]quotaGroup, 0, len(results))
+	unavailable := 0
+	var firstError error
+	for index, result := range results {
+		if result.Status == pool.StatusDisabled {
+			continue
+		}
+		if result.Status != pool.StatusHealthy || result.Usage == nil {
+			unavailable++
+			if firstError == nil {
+				firstError = errors.New("OpenCode Go quota is unavailable for a configured key")
+			}
+			continue
+		}
+		buckets, err := quotaBuckets(*result.Usage)
+		if err != nil {
+			unavailable++
+			if firstError == nil {
+				firstError = err
+			}
+			continue
+		}
+		displayName := "OpenCode Go"
+		if len(results) > 1 {
+			displayName = fmt.Sprintf("Account %d", index+1)
+		}
+		groups = append(groups, quotaGroup{DisplayName: displayName, Buckets: buckets})
+	}
+	if len(groups) == 0 {
+		if firstError != nil {
+			return nil, firstError
+		}
+		return nil, errors.New("no active OpenCode Go credentials configured")
+	}
+	var summary []quotaMetric
+	if unavailable > 0 {
+		summary = []quotaMetric{{Key: "unavailable_accounts", Label: "Unavailable accounts", Value: unavailable, Format: "number"}}
+	}
+
+	return okEnvelope(quotaFetchResponse{
+		Subscription: quotaSubscription{Plan: "Go"},
+		Summary:      summary,
+		Groups:       groups,
+	})
+}
+
+func quotaBuckets(usage opencode.Usage) ([]quotaBucket, error) {
+	windows := []struct {
+		name        string
+		description string
+		value       opencode.Window
+	}{
+		{name: "5h", description: "5-hour", value: usage.Rolling},
+		{name: "weekly", description: "Weekly", value: usage.Weekly},
+		{name: "monthly", description: "Monthly", value: usage.Monthly},
+	}
+	buckets := make([]quotaBucket, 0, len(windows))
+	for _, window := range windows {
+		if strings.TrimSpace(window.value.Status) == "" {
+			return nil, fmt.Errorf("%s quota window is missing status", window.name)
+		}
+		if window.value.ResetsAt.IsZero() {
+			return nil, fmt.Errorf("%s quota window is missing reset time", window.name)
+		}
+		buckets = append(buckets, quotaBucket{
+			Window:            window.name,
+			RemainingFraction: 1 - window.value.Percent/100,
+			ResetTime:         window.value.ResetsAt.Format(time.RFC3339Nano),
+			Description:       window.description,
+		})
+	}
+	return buckets, nil
+}
