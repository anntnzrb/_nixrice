+func (w *Window) UnmarshalJSON(data []byte) error {
+	var value struct {
+		Status   string    `json:"status"`
+		Percent  *float64  `json:"percent"`
+		ResetsAt time.Time `json:"resetsAt"`
+	}
+	if err := json.Unmarshal(data, &value); err != nil {
+		return err
+	}
+	if value.Percent == nil {
+		return errors.New("usage window is missing percent")
+	}
+	if *value.Percent < 0 || *value.Percent > 100 {
+		return errors.New("usage window percent must be between 0 and 100")
+	}
+	*w = Window{Status: value.Status, Percent: *value.Percent, ResetsAt: value.ResetsAt}
+	return nil
