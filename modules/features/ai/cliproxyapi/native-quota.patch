+func TestQuotaFetchUsesFreshConfigAndReturnsSecretFreeGroups(t *testing.T) {
+	const (
+		firstKey   = "go-key-first-secret"
+		secondKey  = "go-key-second-secret"
+		rotatedKey = "go-key-rotated-secret"
+	)
+	var (
+		mu   sync.Mutex
+		seen []string
+	)
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+		if r.URL.Path != "/v1/usage" {
+			http.NotFound(w, r)
+			return
+		}
+		key := strings.TrimPrefix(r.Header.Get("Authorization"), "Bearer ")
+		mu.Lock()
+		seen = append(seen, key)
+		mu.Unlock()
+		switch key {
+		case firstKey, secondKey, rotatedKey:
+			w.Header().Set("Content-Type", "application/json")
+			_, _ = w.Write([]byte(validQuotaUsage))
+		default:
+			http.Error(w, "unauthorized", http.StatusUnauthorized)
+		}
+	}))
+	defer server.Close()
+
+	configPath := filepath.Join(t.TempDir(), "config.yaml")
+	setQuotaProviderConfig(t, configPath)
+	writeQuotaConfig(t, configPath, server.URL, firstKey, secondKey)
+
+	firstRaw, err := callQuotaFetch(t, quotaProviderID)
+	if err != nil {
+		t.Fatalf("first quota.fetch error = %v", err)
+	}
+	first := decodeQuotaFetchResponse(t, firstRaw)
+	if first.Subscription.Plan != "Go" || len(first.Groups) != 2 {
+		t.Fatalf("unexpected first quota response: %#v", first)
+	}
+	assertQuotaGroup(t, first.Groups[0], "Account 1")
+	assertQuotaGroup(t, first.Groups[1], "Account 2")
+	assertNoConfiguredKeys(t, firstRaw, firstKey, secondKey, rotatedKey)
+
+	writeQuotaConfig(t, configPath, server.URL, rotatedKey)
+	secondRaw, err := callQuotaFetch(t, quotaProviderID)
+	if err != nil {
+		t.Fatalf("rotated quota.fetch error = %v", err)
+	}
+	second := decodeQuotaFetchResponse(t, secondRaw)
+	if second.Subscription.Plan != "Go" || len(second.Groups) != 1 {
+		t.Fatalf("unexpected rotated quota response: %#v", second)
+	}
+	assertQuotaGroup(t, second.Groups[0], "OpenCode Go")
+	assertNoConfiguredKeys(t, secondRaw, firstKey, secondKey, rotatedKey)
+
+	mu.Lock()
+	defer mu.Unlock()
+	counts := make(map[string]int, len(seen))
+	for _, key := range seen {
+		counts[key]++
+	}
+	if len(seen) != 3 || counts[firstKey] != 1 || counts[secondKey] != 1 || counts[rotatedKey] != 1 {
+		t.Fatalf("usage requests did not follow the current config: %#v", seen)
+	}
+}
