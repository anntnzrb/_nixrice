+func TestQuotaFetchRetainsHealthyAccountsWhenAnotherIsUnavailableOrDisabled(t *testing.T) {
+	for _, disabled := range []bool{false, true} {
+		t.Run(fmt.Sprintf("disabled=%t", disabled), func(t *testing.T) {
+			const healthyKey, otherKey = "healthy-go-secret", "other-go-secret"
+			server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				if r.Header.Get("Authorization") != "Bearer "+healthyKey {
+					if disabled {
+						t.Error("disabled credential was queried")
+					}
+					http.Error(w, "unavailable", http.StatusUnauthorized)
+					return
+				}
+				_, _ = w.Write([]byte(validQuotaUsage))
+			}))
+			defer server.Close()
+			path := filepath.Join(t.TempDir(), "config.yaml")
+			setQuotaProviderConfig(t, path)
+			writeQuotaConfig(t, path, server.URL, healthyKey, otherKey)
+			if disabled {
+				file, err := os.OpenFile(path, os.O_APPEND|os.O_WRONLY, 0o600)
+				if err != nil {
+					t.Fatal(err)
+				}
+				if _, err := file.WriteString("        weight: 0\n"); err != nil {
+					t.Fatal(err)
+				}
+				if err := file.Close(); err != nil {
+					t.Fatal(err)
+				}
+			}
+			raw, err := callQuotaFetch(t, quotaProviderID)
+			if err != nil {
+				t.Fatal(err)
+			}
+			response := decodeQuotaFetchResponse(t, raw)
+			if len(response.Groups) != 1 {
+				t.Fatalf("healthy account missing: %#v", response)
+			}
+			assertQuotaGroup(t, response.Groups[0], "Account 1")
+			if disabled {
+				if len(response.Summary) != 0 {
+					t.Fatalf("disabled account reported as failed: %#v", response.Summary)
+				}
+			} else if len(response.Summary) != 1 || response.Summary[0].Key != "unavailable_accounts" || response.Summary[0].Value != 1 {
+				t.Fatalf("unavailable account is not visible: %#v", response.Summary)
+			}
+			assertNoConfiguredKeys(t, raw, healthyKey, otherKey)
+		})
+	}
+}
+
+func TestQuotaFetchPreservesZeroRemainingForExhaustedWindow(t *testing.T) {
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		_, _ = w.Write([]byte(strings.Replace(validQuotaUsage, `"percent":8`, `"percent":100`, 1)))
+	}))
+	defer server.Close()
+	path := filepath.Join(t.TempDir(), "config.yaml")
+	setQuotaProviderConfig(t, path)
+	writeQuotaConfig(t, path, server.URL, "exhausted-go-secret")
+	raw, err := callQuotaFetch(t, quotaProviderID)
+	if err != nil {
+		t.Fatal(err)
+	}
+	response := decodeQuotaFetchResponse(t, raw)
+	if response.Groups[0].Buckets[0].RemainingFraction != 0 || !bytes.Contains(raw, []byte(`"remainingFraction":0`)) {
+		t.Fatalf("exhausted window lost its zero remaining reading: %s", raw)
+	}
+}
