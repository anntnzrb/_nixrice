+func TestQuotaIdentityAndDescription(t *testing.T) {
+	identifier, err := handleMethod("quota.identifier", nil)
+	if err != nil {
+		t.Fatalf("quota.identifier error = %v", err)
+	}
+	var identifierEnvelope testEnvelope
+	if err := json.Unmarshal(identifier, &identifierEnvelope); err != nil {
+		t.Fatalf("decode identifier envelope: %v", err)
+	}
+	var identifierResponse quotaIdentifierResponse
+	if err := json.Unmarshal(identifierEnvelope.Result, &identifierResponse); err != nil {
+		t.Fatalf("decode identifier: %v", err)
+	}
+	if !identifierEnvelope.OK || identifierResponse.Identifier != quotaProviderID {
+		t.Fatalf("unexpected identifier: %#v", identifierResponse)
+	}
+
+	description, err := handleMethod("quota.describe", nil)
+	if err != nil {
+		t.Fatalf("quota.describe error = %v", err)
+	}
+	var descriptionEnvelope testEnvelope
+	if err := json.Unmarshal(description, &descriptionEnvelope); err != nil {
+		t.Fatalf("decode description envelope: %v", err)
+	}
+	var descriptionResponse quotaDescribeResponse
+	if err := json.Unmarshal(descriptionEnvelope.Result, &descriptionResponse); err != nil {
+		t.Fatalf("decode description: %v", err)
+	}
+	if !descriptionEnvelope.OK || descriptionResponse.DisplayName != "OpenCode Go" ||
+		len(descriptionResponse.SupportedProviders) != 1 ||
+		descriptionResponse.SupportedProviders[0] != quotaProviderID || descriptionResponse.SupportsReset {
+		t.Fatalf("unexpected description: %#v", descriptionResponse)
+	}
+}
