+func TestQuotaFetchRejectsUnhealthyUpstreamWithoutLeakingKey(t *testing.T) {
+	const secret = "go-key-unhealthy-secret"
+	server := httptest.NewServer(http.HandlerFunc(func(w http.ResponseWriter, _ *http.Request) {
+		http.Error(w, "unauthorized", http.StatusUnauthorized)
+	}))
+	defer server.Close()
+
+	configPath := filepath.Join(t.TempDir(), "config.yaml")
+	setQuotaProviderConfig(t, configPath)
+	writeQuotaConfig(t, configPath, server.URL, secret)
+
+	raw, err := callQuotaFetch(t, quotaProviderID)
+	if err == nil || !strings.Contains(err.Error(), "quota is unavailable") {
+		t.Fatalf("quota.fetch error = %v, want unavailable quota", err)
+	}
+	if strings.Contains(err.Error(), secret) || bytes.Contains(raw, []byte(secret)) {
+		t.Fatalf("quota.fetch failure leaks API key: error=%v result=%s", err, raw)
+	}
+}
